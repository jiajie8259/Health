rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 階段 1（先發布這一版，用來完成第一次登入與連線測試）
    // 每個登入者只能讀寫「自己 uid 底下」的資料，其他路徑全部拒絕。
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // 階段 2（取得你的 UID 後，把上面整段 match 換成下面這段再發布）
    // 連「自己 uid 底下」也只允許你本人的 UID，其他 Google 帳號完全無法寫入。
    //
    // match /users/{uid}/{document=**} {
    //   allow read, write: if request.auth != null
    //                      && request.auth.uid == uid
    //                      && uid == 'YOUR_UID';
    // }
  }
}
